# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=your_database_name

# DB fallback if JSON schema misses columns/tables; if true, retry with live DB schema
SCHEMA_DB_FALLBACK=true
# Max tables to include in prompt after slicing
SCHEMA_SLICE_MAX_TABLES=12
# Python NL→SQL cache (seconds and entries)
NLSQL_CACHE_TTL_SECONDS=600
NLSQL_CACHE_MAX_ENTRIES=512
# Go DB result cache (seconds and entries)
EXEC_CACHE_TTL_SECONDS=300
EXEC_CACHE_MAX_ENTRIES=512


# Server Configuration
SERVER_PORT=8080

# Application Environment
APP_ENV=development
GIN_MODE=debug

# Security (add as needed)
JWT_SECRET=your-super-secret-jwt-key-here
API_KEY=your-api-key-here

# NL→SQL Python service (local) - the Go API calls this server
NLSQL_URL=http://127.0.0.1:7337

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual configuration
# 3. Never commit .env to version control - it's ignored by .gitignore