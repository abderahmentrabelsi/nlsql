{
  "tables": {
    "users": [
      "id",
      "created_at",
      "updated_at",
      "deleted_at",
      "name",
      "email",
      "phone",
      "address"
    ],
    "orders": [
      "id",
      "created_at",
      "updated_at",
      "deleted_at",
      "order_number",
      "description",
      "amount",
      "status",
      "order_date",
      "ship_date",
      "user_id"
    ]
  },
  "relationships": [
    {
      "from_table": "orders",
      "from_column": "user_id",
      "to_table": "users",
      "to_column": "id"
    }
  ],
  "services": {
    "orderService": {
      "methods": {
        "getOrdersByUser": ["user_id"],
        "getOrdersByStatus": ["status"]
      }
    },
    "userService": {
      "methods": {
        "getUserByEmail": ["email"]
      }
    }
  },
  "synonyms": {
    "cost": "orders.amount",
    "total_amount": "orders.amount",
    "invoice_total": "orders.amount",
    "signup_date": "users.created_at",
    "user_name": "users.name",
    "fullname": "users.name",
    "telephone": "users.phone",
    "state": "orders.status",
    "order_status": "orders.status",
    "item_name": "orders.description",
    "product_name": "orders.description",
    "customer": "users",
    "customers": "users"
  }
}